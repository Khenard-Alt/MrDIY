<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingBottom="32dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_sheet_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Experience"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <!-- Role -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_exp_role"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Job Title / Role"
        android:layout_marginBottom="12dp"
        style="@style/DiyTextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_exp_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Company -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_exp_company"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Company / Employer"
        android:layout_marginBottom="12dp"
        style="@style/DiyTextInputLayout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_exp_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textSize="14sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Currently Working Here switch -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_is_current"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Currently working here"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:checked="true"
        android:layout_marginBottom="12dp"
        app:thumbTint="@color/orange_primary"
        app:trackTint="@color/orange_light" />

    <!-- Start / End Year row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <!-- Start Year -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_exp_start_year"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="Start Year"
            android:layout_marginEnd="8dp"
            style="@style/DiyTextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_exp_start_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- End Year (hidden when isCurrent) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_exp_end_year"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="End Year"
            android:visibility="gone"
            style="@style/DiyTextInputLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_exp_end_year"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_exp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp"
            style="@style/DiyOutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_exp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="Save"
            android:textSize="14sp"
            android:textStyle="bold"
            style="@style/DiyFilledButton" />

    </LinearLayout>

</LinearLayout>
