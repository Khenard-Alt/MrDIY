<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/job_card"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp"
    app:rippleColor="@color/orange_ripple">

    <LinearLayout android:background="@drawable/job_accent"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Logo + Title + Remove Button -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Company Logo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp" android:layout_height="40dp"
                app:cardBackgroundColor="@color/orange_light"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_company_initial"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:text="DIY"
                    android:textColor="@color/orange_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Job Info -->
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginHorizontal="10dp">

                <TextView
                    android:id="@+id/tv_job_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Store Supervisor"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_company_branch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="MR.D.I.Y. Philippines · SM Marikina"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <!-- Remove Button -->
            <ImageButton
                android:id="@+id/btn_remove"
                android:layout_width="32dp" android:layout_height="32dp"
                android:src="@drawable/ic_bookmark_filled"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/orange_primary"
                android:contentDescription="Remove saved job" />

        </LinearLayout>

        <!-- Tags Row -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                app:chipSpacingHorizontal="4dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_job_type"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Full-time"
                    style="@style/DiyTagChip" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_location"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Metro Manila"
                    style="@style/DiyTagChipGray" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_category"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Retail"
                    style="@style/DiyTagChipGray" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border_light"
            android:layout_marginBottom="10dp" />

        <!-- Footer: Salary + Action Button -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_salary"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="₱25,000 – ₱32,000/mo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btn_apply"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Apply"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                app:backgroundTint="@color/orange_primary"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
