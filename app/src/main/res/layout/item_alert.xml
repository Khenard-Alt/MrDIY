<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white" app:cardCornerRadius="12dp"
    app:cardElevation="0dp" app:strokeColor="@color/border_light" app:strokeWidth="1dp"
    app:rippleColor="@color/orange_ripple">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">

        <!-- Icon -->
        <TextView android:id="@+id/tv_alert_icon"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/circle_white_20"
            android:gravity="center" android:textSize="18sp"
            android:layout_marginEnd="12dp"/>

        <!-- Text block -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_alert_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/text_primary" android:layout_marginBottom="2dp"/>
            <TextView android:id="@+id/tv_alert_message"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text_secondary"
                android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="2dp"/>
            <TextView android:id="@+id/tv_alert_time"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Unread dot -->
        <View android:id="@+id/view_unread_dot"
            android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/badge_red" android:layout_marginStart="8dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
