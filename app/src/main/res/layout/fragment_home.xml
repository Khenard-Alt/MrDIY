<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_yellow"
        app:elevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="16dp">

            <!-- Logo Icon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/logo_card"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/logo_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/mr_diy_logo1"
                    android:scaleType="centerCrop"
                    android:contentDescription="App Logo"
                    android:padding="2dp"/>


            </com.google.android.material.card.MaterialCardView>

            <!-- App Title Block -->
            <LinearLayout
                android:id="@+id/title_block"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                app:layout_constraintStart_toEndOf="@id/logo_card"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/action_icons">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MR.D.I.Y."
                    android:textColor="@color/brand_black"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAREERS"
                    android:textColor="#CC1B1B1B"
                    android:textSize="9sp"
                    android:letterSpacing="0.1" />

            </LinearLayout>

            <!-- Action Icons -->
            <LinearLayout
                android:id="@+id/action_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:spacing="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp">

                    <ImageButton
                        android:id="@+id/btn_notifications"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_notifications"
                        android:background="@drawable/circle_white_20"
                        app:tint="@color/white"
                        android:contentDescription="Notifications"
                        android:padding="8dp" />

                    <View
                        android:id="@+id/notification_badge"
                        android:visibility="gone"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="2dp"
                        android:background="@drawable/badge_red" />

                </FrameLayout>

                <ImageButton
                    android:id="@+id/btn_messages"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_chat"
                    android:background="@drawable/circle_white_20"
                    app:tint="@color/white"
                    android:contentDescription="Messages"
                    android:padding="8dp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_muted"
                        android:contentDescription="Search" />

                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="8dp"
                        android:hint="Search jobs, skills, locations…"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp"
                        android:textColor="@color/text_primary"
                        android:background="@null"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/btn_filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    <ImageView android:layout_width="match_parent" android:layout_height="20dp" android:scaleType="fitXY" android:src="@drawable/yellow_wave" android:importantForAccessibility="no"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Content. The job list scrolls by itself and list_header is shown as its first
         row (see HeaderViewAdapter); a RecyclerView inside a NestedScrollView inflates every card
         at once and freezes the UI once there are many jobs. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/list_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">

    <!-- Welcome Banner -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="16dp"
        android:paddingTop="16dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/tv_greeting"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Good morning," android:textSize="12sp" android:textColor="@color/text_muted"/>
        <TextView android:id="@+id/tv_user_name"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Juan Dela Cruz 👋" android:textSize="20sp" android:textStyle="bold"
            android:textColor="@color/text_primary"/>
    </LinearLayout>

    <!-- Quick Stats Row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="16dp"
        android:paddingTop="10dp" android:paddingBottom="12dp">

        <!-- Applied -->
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" app:cardBackgroundColor="@color/orange_light"
            app:cardCornerRadius="12dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:id="@+id/tv_stat_applied"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textSize="26sp" android:textStyle="bold"
                    android:textColor="@color/orange_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Applied Jobs" android:textSize="11sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Saved -->
        <com.google.android.material.card.MaterialCardView android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="12dp" app:cardElevation="0dp"
            app:strokeColor="@color/border_light" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="14dp">
                <TextView android:id="@+id/tv_stat_saved"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textSize="26sp" android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Saved Jobs" android:textSize="11sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Empty state (below stats) -->
    <TextView android:id="@+id/tv_empty_state"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No jobs match your search." android:gravity="center"
        android:textSize="14sp" android:textColor="@color/text_muted"
        android:padding="32dp" android:visibility="gone"/>


            <!-- Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="16dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/filter_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:chipSpacingHorizontal="6dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All Jobs"
                            android:checked="true"
                            style="@style/DiyFilterChip" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_fulltime"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full-time"
                            style="@style/DiyFilterChip" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_parttime"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Part-time"
                            style="@style/DiyFilterChip" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_near_me"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Near Me"
                            style="@style/DiyFilterChip" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_manila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Metro Manila"
                            style="@style/DiyFilterChip" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_rizal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rizal"
                            style="@style/DiyFilterChip" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_cavite"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cavite"
                            style="@style/DiyFilterChip" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_laguna"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Laguna"
                            style="@style/DiyFilterChip" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_bulacan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bulacan"
                            style="@style/DiyFilterChip" />

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>

            </HorizontalScrollView>

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:text="LATEST PUBLISHED JOBS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:letterSpacing="0.08" />

        </LinearLayout>

        <!-- Job Cards RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/jobs_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
