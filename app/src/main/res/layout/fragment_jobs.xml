<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_black">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Browse Jobs"
                android:textColor="@color/brand_yellow"
                android:textSize="18sp" android:textStyle="bold"/>
            <TextView
                android:id="@+id/tv_job_count"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="8 jobs found"
                android:textColor="#B8B8B0" android:textSize="12sp"/>
        </LinearLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp" android:paddingBottom="10dp">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="44dp"
                app:cardBackgroundColor="@color/white" app:cardCornerRadius="10dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">
                    <ImageView
                        android:layout_width="18dp" android:layout_height="18dp"
                        android:src="@drawable/ic_search" app:tint="@color/text_muted"
                        android:contentDescription="Search"/>
                    <EditText
                        android:id="@+id/search_input"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:layout_marginHorizontal="8dp"
                        android:hint="Search title, company, location…"
                        android:textColorHint="@color/text_muted" android:textSize="13sp"
                        android:textColor="@color/text_primary" android:background="@null"
                        android:imeOptions="actionSearch" android:inputType="text"
                        android:singleLine="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- The job list scrolls by itself; list_header is shown as its first row (HeaderViewAdapter). -->
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:id="@+id/list_header"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="12dp">

            <!-- Category filter label -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="6dp"
                android:text="CATEGORY" android:textSize="10sp" android:textStyle="bold"
                android:textColor="@color/text_muted" android:letterSpacing="0.08"/>

            <HorizontalScrollView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:scrollbars="none"
                android:paddingHorizontal="16dp" android:paddingBottom="10dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_category"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:singleSelection="true" app:chipSpacingHorizontal="6dp">
                    <com.google.android.material.chip.Chip android:id="@+id/chip_all_cat"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="All" android:checked="true" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_retail"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Retail" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_logistics"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Logistics" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_corporate"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Corporate" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_it"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="IT" style="@style/DiyFilterChip"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Location filter label -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="6dp"
                android:text="LOCATION" android:textSize="10sp" android:textStyle="bold"
                android:textColor="@color/text_muted" android:letterSpacing="0.08"/>

            <HorizontalScrollView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:scrollbars="none"
                android:paddingHorizontal="16dp" android:paddingBottom="10dp">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_location"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:singleSelection="true" app:chipSpacingHorizontal="6dp">
                    <com.google.android.material.chip.Chip android:id="@+id/chip_loc_all"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="All" android:checked="true" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_loc_manila"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Metro Manila" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_loc_taguig"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="BGC, Taguig" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_loc_laguna"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Laguna" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_loc_cebu"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cebu City" style="@style/DiyFilterChip"/>
                    <com.google.android.material.chip.Chip android:id="@+id/chip_loc_davao"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Davao City" style="@style/DiyFilterChip"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Salary range -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="4dp"
                android:text="SALARY RANGE" android:textSize="10sp" android:textStyle="bold"
                android:textColor="@color/text_muted" android:letterSpacing="0.08"/>
            <com.google.android.material.slider.RangeSlider
                android:id="@+id/salary_slider"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp" android:layout_marginBottom="4dp"
                android:valueFrom="0" android:valueTo="100000"
                app:values="@array/salary_defaults"
                app:thumbColor="@color/orange_primary"
                app:trackColorActive="@color/orange_primary"
                app:trackColorInactive="@color/border_light"/>

            <!-- Clear filters -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_filters"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp"
                android:text="Clear Filters" android:textSize="12sp"
                style="@style/DiyOutlinedButton" app:cornerRadius="8dp"/>

            <!-- Empty state -->
            <TextView android:id="@+id/tv_empty_state"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="No jobs match your filters." android:gravity="center"
                android:textSize="14sp" android:textColor="@color/text_muted"
                android:padding="32dp" android:visibility="gone"/>
        </LinearLayout>

        <!-- Jobs list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/jobs_recycler"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingBottom="16dp" android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>