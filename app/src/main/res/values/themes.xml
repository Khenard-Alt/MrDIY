<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================== App Theme ===================== -->
    <style name="Theme.MrDIYCareers" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/orange_primary</item>
        <item name="colorPrimaryVariant">@color/orange_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/orange_light</item>
        <item name="colorOnSecondary">@color/orange_dark</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorError">@color/red_error</item>
        <item name="android:statusBarColor">@color/brand_yellow</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ===================== Toolbar ===================== -->
    <style name="ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- ===================== Buttons ===================== -->

    <!-- Filled Orange Button -->
    <style name="DiyFilledButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/orange_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="rippleColor">@color/orange_dark</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Outlined Orange Button -->
    <style name="DiyOutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/orange_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/orange_primary</item>
        <item name="rippleColor">@color/orange_light</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ===================== Chips ===================== -->

    <!-- Filter chips in Home (toggle-able) -->
    <style name="DiyFilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipBackgroundColor">@color/chip_filter_bg_selector</item>
        <item name="android:textColor">@color/chip_filter_text_selector</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipCornerRadius">4dp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Orange Tags on job cards -->
    <style name="DiyTagChip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipBackgroundColor">@color/orange_light</item>
        <item name="android:textColor">@color/orange_dark</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="closeIconVisible">false</item>
        <item name="android:checkable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Gray Tags on job cards -->
    <style name="DiyTagChipGray" parent="@style/DiyTagChip">
        <item name="chipBackgroundColor">@color/bg_secondary</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Job Detail header transparent chips -->
    <style name="DiyJdTagChip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipBackgroundColor">#33FFFFFF</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">26dp</item>
        <item name="chipCornerRadius">13dp</item>
        <item name="closeIconVisible">false</item>
        <item name="android:checkable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Profile skill chips -->
    <style name="DiySkillChip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="chipBackgroundColor">@color/orange_light</item>
        <item name="android:textColor">@color/orange_dark</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="closeIconVisible">false</item>
        <item name="android:checkable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ===================== Text Inputs ===================== -->
    <style name="DiyTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_stroke_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintTextColor">@color/text_input_hint_selector</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxBackgroundColor">@color/white</item>
    </style>

    <style name="NeutralAutofill" />
</resources>
