<?xml version="1.0" encoding="utf-8"?>
<!-- res/navigation/nav_graph.xml -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- ── Auth ──────────────────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.mrdiy.careers.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_phoneLoginFragment"
            app:destination="@id/phoneLoginFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_loginFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.mrdiy.careers.ui.auth.RegisterFragment"
        android:label="Register">
        <action
            android:id="@+id/action_registerFragment_to_emailVerification"
            app:destination="@id/emailVerificationFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_registerFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/emailVerificationFragment"
        android:name="com.mrdiy.careers.ui.auth.EmailVerificationFragment"
        android:label="Verify Email">
        <argument
            android:name="email"
            app:argType="string"
            android:defaultValue="" />
        <action
            android:id="@+id/action_emailVerificationFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.mrdiy.careers.ui.auth.WelcomeFragment"
        android:label="Welcome">
        <action
            android:id="@+id/action_welcomeFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/phoneLoginFragment"
        android:name="com.mrdiy.careers.ui.auth.PhoneLoginFragment"
        android:label="Phone Login">
        <action
            android:id="@+id/action_phoneLoginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ── Main App ───────────────────────────────────────────────────────────── -->

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.mrdiy.careers.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_jobDetail"
            app:destination="@id/jobDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/jobsFragment"
        android:name="com.mrdiy.careers.ui.jobs.JobsFragment"
        android:label="Jobs">
        <action
            android:id="@+id/action_jobs_to_jobDetail"
            app:destination="@id/jobDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/alertsFragment"
        android:name="com.mrdiy.careers.ui.alerts.AlertsFragment"
        android:label="Notifications">
        <action
            android:id="@+id/action_alerts_to_jobDetail"
            app:destination="@id/jobDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.mrdiy.careers.ui.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profile_to_editProfile"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profile_to_resumeUpload"
            app:destination="@id/resumeUploadFragment" />
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_profile_to_savedJobs"
            app:destination="@id/savedJobsFragment" />
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <!-- Messages Fragment -->
    <fragment
        android:id="@+id/messagesFragment"
        android:name="com.mrdiy.careers.ui.messages.MessagesFragment"
        android:label="Messages">
        <action
            android:id="@+id/action_messages_to_jobDetail"
            app:destination="@id/jobDetailFragment" />
    </fragment>

    <!-- One application: timeline, interview, documents (argument: applicationId) -->
    <fragment
        android:id="@+id/applicationDetailFragment"
        android:name="com.mrdiy.careers.ui.applications.ApplicationDetailFragment"
        android:label="Application">
        <action
            android:id="@+id/action_applicationDetail_to_signContract"
            app:destination="@id/signContractFragment" />
    </fragment>

    <!-- In-app signature for the "Signed Employment Contract" requirement -->
    <fragment
        android:id="@+id/signContractFragment"
        android:name="com.mrdiy.careers.ui.applications.SignContractFragment"
        android:label="Sign Contract" />

    <!-- Chat with HR (opened from Messages; argument: otherId) -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.mrdiy.careers.ui.messages.ChatFragment"
        android:label="Chat" />

    <!-- Saved Jobs Fragment -->
    <fragment
        android:id="@+id/savedJobsFragment"
        android:name="com.mrdiy.careers.ui.savedjobs.SavedJobsFragment"
        android:label="Saved Jobs">
        <action
            android:id="@+id/action_savedJobs_to_jobDetail"
            app:destination="@id/jobDetailFragment" />
    </fragment>

    <!-- Settings Fragment -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.mrdiy.careers.ui.settings.SettingsFragment"
        android:label="Settings">
        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/applicationsFragment"
        android:name="com.mrdiy.careers.ui.applications.ApplicationsFragment"
        android:label="Applications" />

    <fragment
        android:id="@+id/myDocumentsFragment"
        android:name="com.mrdiy.careers.ui.profile.MyDocumentsFragment"
        android:label="My Documents" />

    <fragment
        android:id="@+id/jobDetailFragment"
        android:name="com.mrdiy.careers.ui.jobs.JobDetailFragment"
        android:label="Job Detail">
        <argument
            android:name="jobId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.mrdiy.careers.ui.profile.EditProfileFragment"
        android:label="Edit Profile" />

    <fragment
        android:id="@+id/resumeUploadFragment"
        android:name="com.mrdiy.careers.ui.resume.ResumeUploadFragment"
        android:label="Upload Resume">
        <action
            android:id="@+id/action_resumeUpload_to_recommendations"
            app:destination="@id/recommendedJobsFragment"
            app:popUpTo="@id/resumeUploadFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/recommendedJobsFragment"
        android:name="com.mrdiy.careers.ui.recommendations.RecommendedJobsFragment"
        android:label="For You">
        <action
            android:id="@+id/action_recommendations_to_resumeUpload"
            app:destination="@id/resumeUploadFragment" />
        <action
            android:id="@+id/action_recommendations_to_jobDetail"
            app:destination="@id/jobDetailFragment" />
    </fragment>

</navigation>